{
	"pcode": "D0070315",
	"LawLevel": "命令",
	"name": "建築物室內裝修業及專業技術人員登記證收費標準",
	"category": [
		"行政",
		"內政部",
		"國土管理目"
	],
	"LawModifiedDate": "20251022",
	"histories": [
		"一百十四年十月二十二日內政部台內國字第 1140813996 號令訂定發布全文 3 條；並自發布日施行"
	],
	"articles": [
		{
			"number": 100,
			"content": [
				{
					"text": "本標準依規費法第十條第一項規定訂定之。"
				}
			]
		},
		{
			"number": 200,
			"content": [
				{
					"text": "建築物室內裝修業及專業技術人員登記證規費收費如下：",
					"children": [
						{
							"text": "一、室內裝修業登記證：",
							"children": [
								{
									"text": "（一）設立：每件新臺幣四千元。"
								},
								{
									"text": "（二）變更：每件新臺幣二千元。"
								},
								{
									"text": "（三）換（補）發：每件新臺幣二千元。"
								}
							]
						},
						{
							"text": "二、專業技術人員登記證：",
							"children": [
								{
									"text": "（一）申請：每件新臺幣一千五百元。"
								},
								{
									"text": "（二）變更：每件新臺幣一千元。"
								},
								{
									"text": "（三）換（補）發：每件新臺幣一千元。"
								}
							]
						}
					]
				}
			]
		},
		{
			"number": 300,
			"content": [
				{
					"text": "本標準自發布日施行。"
				}
			]
		}
	]
}