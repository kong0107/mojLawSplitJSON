	"histories": [
		"一百十四年六月三十日客家委員會客家文化發展中心客發推字第 1148300419 號令訂定發布全文 6 條；並自發布日施行"
	],
	"articles": [
		{
			"number": 100,
			"content": [
				{
					"text": "依規費法第十條第一項規定訂定之。"
				}
			]
		},
		{
			"number": 200,
			"content": [
				{
					"text": "所稱場地為六堆客家文化園區露營區。"
				}
			]
		},
		{
			"number": 300,
			"content": [
				{
					"text": "本露營區收費標準如附表。"
				}
			]
		},
		{
			"number": 400,
			"content": [
				{
					"text": "所定收費基準依規費法相關規定辦理，每三年至少檢討一次。"
				}
			]
		},
		{
			"number": 500,
			"content": [
				{
					"text": "使用規費，為考量博物館肩負教育推廣責任，本園區與各機關學校共同辦理業務、教育宣導或協助事項活動時，經本中心核准後，得免收取或優惠相關費用。"
				}
			]
		},
		{
			"number": 600,
			"content": [
				{
					"text": "自發布日施行。"
				}
			]
		}
	]
}