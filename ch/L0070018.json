{
	"pcode": "L0070018",
	"LawLevel": "命令",
	"name": "助產機構設置標準",
	"category": [
		"行政",
		"衛生福利部",
		"護理及健康照護目"
	],
	"LawModifiedDate": "20260205",
	"histories": [
		"九十四年八月三日行政院衛生署衛署醫字第 0940223640 號令訂定發布全文 6 條；本標準施行日期，除第三條第六款規定自九十六年一月一日施行外，自發布日施行",
		"一百十五年二月五日衛生福利部衛部照字第 1151560176 號令修正發布全文 5 條；並自發布日施行"
	],
	"articles": [
		{
			"number": 100,
			"content": [
				{
					"text": "本標準依助產人員法第十三條第三項規定訂定之。"
				}
			]
		},
		{
			"number": 200,
			"content": [
				{
					"text": "助產機構供照護產婦及新生兒使用之空間，不得設於地下樓層。"
				}
			]
		},
		{
			"number": 300,
			"content": [
				{
					"text": "助產機構之空間、設施及設備，應符合下列規定：",
					"children": [
						{
							"text": "一、產婦待產、生產、恢復之產床、設施或設備，其空間以提供九床或產婦九人為限；並置有維護隱私之設施或設備。"
						},
						{
							"text": "二、緊急呼叫系統。"
						},
						{
							"text": "三、嬰兒床或嬰兒睡籃。"
						},
						{
							"text": "四、保存執行業務紀錄之設備，並有專責人員管理。"
						},
						{
							"text": "五、清潔及消毒設備。"
						},
						{
							"text": "六、手部衛生設備。"
						},
						{
							"text": "七、汙物處理設備。"
						},
						{
							"text": "八、其他中央主管機關指定之空間、設施及設備。"
						}
					]
				}
			]
		},
		{
			"number": 400,
			"content": [
				{
					"text": "助產機構之藥品、醫療器材及其他相關用物，應符合下列規定：",
					"children": [
						{
							"text": "一、接生器械包及產包。"
						},
						{
							"text": "二、血壓計、體溫計及聽診器。"
						},
						{
							"text": "三、成人及嬰兒體重計。"
						},
						{
							"text": "四、成人及嬰兒身高測量計。"
						},
						{
							"text": "五、成人及嬰兒血氧監測儀。"
						},
						{
							"text": "六、保暖設備。"
						},
						{
							"text": "七、靜脈點滴設備、強心針及其他急救藥品與醫療器材。"
						},
						{
							"text": "八、其他接生用物：",
							"children": [
								{
									"text": "（一）灌腸、導尿器、會陰沖洗器。"
								},
								{
									"text": "（二）會陰縫合器材。"
								},
								{
									"text": "（三）子宮收縮口服藥及針劑。"
								},
								{
									"text": "（四）新生兒用眼藥膏。"
								}
							]
						},
						{
							"text": "九、其他中央主管機關指定之藥品、醫療器材及其他相關用物。"
						}
					]
				}
			]
		},
		{
			"number": 500,
			"content": [
				{
					"text": "本標準自發布日施行。"
				}
			]
		}
	]
}